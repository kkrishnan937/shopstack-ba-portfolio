  <diagram name="05 Supporting rules and scope boundaries" id="cart-v04-5">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1900" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ShopStack: Supporting rules and scope boundaries" style="text;html=0;whiteSpace=wrap;align=left;fontSize=30;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="22" width="1330" height="45" />
        </mxCell>
        <mxCell id="meta" value="Kailas Krishnan | 25 October 2026 | Draft v0.4 | Page 5 of 5" style="text;html=0;whiteSpace=wrap;align=left;fontSize=18;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="82" width="1330" height="35" />
        </mxCell>
        <mxCell id="footer" value="Simulated case study. Proposed behaviour, not implemented or approved. Purple boxes mark open requirements." style="text;html=0;whiteSpace=wrap;align=left;fontSize=18;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1830" width="1330" height="45" />
        </mxCell>
        <mxCell id="merge" value="MERGING: same product and variant share one line; different variants separate. Price alone is not identity." style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#172B4D;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="170" width="1250" height="120" />
        </mxCell>
        <mxCell id="limit" value="LIMIT: 1 to 10 per product/variant, including combined additions. Reject excess; preserve saved values." style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#172B4D;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="370" width="1250" height="120" />
        </mxCell>
        <mxCell id="retention" value="RETENTION: 30 x 24 hours from last successful add, update or removal. Active before expiry; expired at the instant and afterward." style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#172B4D;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="570" width="1250" height="120" />
        </mxCell>
        <mxCell id="noreset" value="NO RESET: viewing, refreshing, sign-in, logout or confirmed failed changes. Explain expired cart; CAD 0.00; Continue shopping." style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#172B4D;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="770" width="1250" height="120" />
        </mxCell>
        <mxCell id="price" value="PRICES: on successful refresh apply current price; notify increases/decreases with old/new unit prices in text; recalculate totals." style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#172B4D;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="970" width="1250" height="120" />
        </mxCell>
        <mxCell id="demo" value="DEMO: item-price subtotals in CAD, two decimals. No tax/shipping calculation or payment. No stock checks or reservation." style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#172B4D;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1170" width="1250" height="120" />
        </mxCell>
        <mxCell id="logout" value="LOGOUT: included in first increment; retain cart without resetting expiry. Security guarantee, token invalidation and failure behaviour remain OPEN (CART-Q-08)." style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F1EAFE;strokeColor=#8B6BB1;fontColor=#172B4D;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1370" width="1250" height="145" />
        </mxCell>
        <mxCell id="scope" value="These are rule references, not sequential steps. Session expiry, in-flight expiry interactions, prolonged recovery and feasibility still need review." style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F1EAFE;strokeColor=#8B6BB1;fontColor=#172B4D;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
